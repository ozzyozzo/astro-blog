{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    { "source": "/projects", "destination": "/proyectos", "permanent": true },
    { "source": "/archives", "destination": "/archivo", "permanent": true },
    { "source": "/search", "destination": "/buscar", "permanent": true },
    { "source": "/about", "destination": "/sobre-mi", "permanent": true },
    { "source": "/contact", "destination": "/contacto", "permanent": true },
    { "source": "/uses", "destination": "/uso", "permanent": true },
    { "source": "/now", "destination": "/ahora", "permanent": true },
    {
      "source": "/tags/presentación",
      "destination": "/etiquetas/presentacion",
      "permanent": true
    },
    {
      "source": "/tags/presentaci%C3%B3n",
      "destination": "/etiquetas/presentacion",
      "permanent": true
    },
    {
      "source": "/tags/:tag",
      "destination": "/etiquetas/:tag",
      "permanent": true
    }
  ]
}
