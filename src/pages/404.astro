---
import Layout from "../layouts/Layout.astro";
import TerminalTitlebar from "../components/TerminalTitlebar.astro";
import { siteConfig } from "../config";
---

<Layout title={`404 - No encontrado | ${siteConfig.title}`}>
  <section class="py-16 min-h-[60vh] flex items-center">
    <div class="container max-w-4xl mx-auto px-6">
      <div class="terminal-window terminal-window-active max-w-2xl mx-auto">
        <TerminalTitlebar path="~/error">
          <span class="text-destructive">exit 1</span>
        </TerminalTitlebar>
        <div class="terminal-content text-center">
          <div class="mb-4 font-mono">
            <span class="terminal-prompt">$</span>
            <span class="terminal-command ml-2">cd {Astro.url.pathname}</span>
          </div>

          <div class="text-destructive font-mono text-lg mb-4">
            bash: cd: {Astro.url.pathname}: No such file or directory
          </div>

          <div class="text-8xl font-bold font-mono text-primary mb-6">404</div>

          <p class="text-muted-foreground mb-6">
            La página que buscas no existe o fue movida.
          </p>

          <div class="mb-4 font-mono text-sm text-muted-foreground">
            <span class="terminal-prompt">$</span>
            <span class="ml-2">Prueba con alguna de estas:</span>
          </div>

          <div class="flex flex-wrap justify-center gap-4 font-mono text-sm">
            <a
              href="/"
              class="px-4 py-2 bg-primary text-primary-foreground rounded hover:bg-primary/90 transition-colors"
            >
              [ir al inicio]
            </a>
            <a
              href="/blog"
              class="px-4 py-2 border border-border rounded hover:bg-card transition-colors"
            >
              [leer el blog]
            </a>
            <a
              href="/proyectos"
              class="px-4 py-2 border border-border rounded hover:bg-card transition-colors"
            >
              [ver proyectos]
            </a>
          </div>

          <div class="flex items-center justify-center mt-6">
            <span class="terminal-prompt">$</span>
            <span class="terminal-cursor ml-2"></span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
